# ─────────────────────────────────────────────────────────────────────────────
# .env.example
#
# Copy to .env and fill in all values marked (REQUIRED) before running
# docker compose up --build
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Django (REQUIRED) ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Database (optional — safe defaults shown) ─────────────────────────────────
POSTGRES_DB=basecms
POSTGRES_USER=basecms

# ── Networking ────────────────────────────────────────────────────────────────
# Hostnames Django will accept (add your domain here in production)
ALLOWED_HOSTS=localhost,127.0.0.1,django,nginx

# Full origins for CSRF validation (must match what the browser sees)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Port nginx binds on the host
HTTP_PORT=80

# ── CMS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of language codes and display names
CMS_AVAILABLE_LANGUAGES=en:English,de:German

# How public CMS pages are rendered:
#   django    → Django templates + block template tags (no Vite build needed)
#   frontend  → React SPA shell  (requires nginx/Dockerfile Vite build)
CMS_SERVE_PUBLIC_PAGES=frontend

# ── Performance ───────────────────────────────────────────────────────────────
Q_WORKERS=2
THROTTLE_ANON=60/minute
THROTTLE_USER=300/minute
CACHE_TIMEOUT=300

# ── Logging ───────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=WARNING
APP_LOG_LEVEL=INFO

# ── Email (optional) ──────────────────────────────────────────────────────────
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Admin error emails (optional) ─────────────────────────────────────────────
# Format: "Name,email@example.com;Name2,email2@example.com"
DJANGO_ADMINS=

# ─────────────────────────────────────────────────────────────────────────────
# nginx.conf — unified reverse proxy for basecms
#
# Routing:
#   /static/          → Django collectstatic volume (immutable, 1-year cache)
#   /media/           → Django user uploads volume  (7-day cache)
#   /assets/          → Vite-hashed JS/CSS bundles  (baked into image, 1-year)
#   /cockpit/         → React cockpit SPA           (baked into image, no-store)
#   /favicon.svg      → static file                 (baked into image)
#   /api/public/      → Django JSON API             (no auth)
#   /api/cockpit/     → Django cockpit API          (staff auth)
#   /api/             → Django (schema, docs, redoc)
#   /accounts/        → Django auth
#   /admin/           → Django admin
#   /<lang>/<slug>/data/ → Django public JSON API   (proxied)
#   /<lang>/<slug>/   → Django (serves react_site.html shell)
#   /                 → Django home
# ─────────────────────────────────────────────────────────────────────────────

worker_processes auto;
error_log  /var/log/nginx/error.log warn;
pid        /tmp/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" "$http_user_agent"';
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/xml image/svg+xml font/woff2;

    client_max_body_size 50M;

    upstream django {
        server django:8000;
        keepalive 32;
    }

    server {
        listen 80;
        server_name _;

        add_header X-Content-Type-Options  "nosniff"                         always;
        add_header X-Frame-Options         "SAMEORIGIN"                      always;
        add_header Referrer-Policy         "strict-origin-when-cross-origin" always;

        # ── Django /static/ volume (ManifestStaticFilesStorage) ──────────────
        location /static/ {
            alias   /app/static/;
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }

        # ── Django /media/ volume ─────────────────────────────────────────────
        location /media/ {
            alias   /app/media/;
            expires 7d;
            add_header Cache-Control "public";
            access_log off;
        }

        # ── Vite-hashed chunks (baked into image) ─────────────────────────────
        location /assets/ {
            root    /usr/share/nginx/html;
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
            try_files $uri =404;
        }

        # ── Favicon (baked into image) ────────────────────────────────────────
        location = /favicon.svg {
            root /usr/share/nginx/html;
            expires 7d;
            access_log off;
        }

        # ── Cockpit SPA — all /cockpit/* served from baked-in index.html ──────
        location = /cockpit {
            return 301 /cockpit/;
        }

        location /cockpit/ {
            root /usr/share/nginx/html;
            add_header Cache-Control "no-store";
            try_files $uri $uri/ @cockpit_index;
        }

        location @cockpit_index {
            root /usr/share/nginx/html;
            rewrite ^ /index.html break;
        }

        # ── API + auth + admin → gunicorn ─────────────────────────────────────
        location ~ ^/(api|accounts|admin)/ {
            proxy_pass         http://django;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_connect_timeout 10s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
            proxy_buffering on;
            proxy_buffer_size 8k;
            proxy_buffers 16 8k;
        }

        # ── Everything else → Django (public pages + home) ────────────────────
        # Django serves react_site.html for /<lang>/<slug>/
        # The React SPA then fetches /<lang>/<slug>/data/ itself (also proxied here)
        location / {
            proxy_pass         http://django;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_connect_timeout 10s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
            proxy_buffering on;
            proxy_buffer_size 8k;
            proxy_buffers 16 8k;
        }

        # ── Health check ──────────────────────────────────────────────────────
        location = /health/ {
            access_log off;
            proxy_pass http://django/api/schema/;
        }
    }
}
